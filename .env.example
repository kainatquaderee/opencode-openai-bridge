# ---------------------------------------------------------------------------
# opencode-openai-bridge v0.7.0
#
# BRIDGE_* namespaced vars are preferred. Legacy PORT/HOST/API_KEY still work
# as fallbacks but are dangerous in shells that export them for other tools
# (OmniRoute exports PORT=20128, which is why we do not read PORT first).
#
# This bridge does NOT bypass rate limits. Do not add egress rotation, proxy
# pools, VPN tricks, or retry-on-429 here. See README "Ethical stance".
# ---------------------------------------------------------------------------

# --- Base bridge ---
BRIDGE_OPENCODE_BIN=opencode

# Attach to a warm `opencode serve` instance (opencode v2 flag: --server).
# The old BRIDGE_OPENCODE_ATTACH name is still accepted as a legacy alias.
# BRIDGE_OPENCODE_SERVER=http://127.0.0.1:4096

BRIDGE_OPENCODE_AUTO=true

# Working directory for the spawned `opencode run` process. The bridge passes
# this as the subprocess cwd; opencode v2 has no --dir flag. Per-request
# override: {"opencode_dir": "/path/to/project"}.
# BRIDGE_OPENCODE_WORKDIR=/path/to/project

BRIDGE_OPENCODE_TIMEOUT=300

# Model used when a request omits "model".
BRIDGE_DEFAULT_MODEL=opencode/deepseek-v4.1-flash-free

# --- Network ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=4097
# BRIDGE_API_KEY=sk-change-me

# --- Response enrichment ---
BRIDGE_INCLUDE_REASONING=false
BRIDGE_INCLUDE_TOOL_CALLS=false

# --- Catalog ---
# Comma list; overrides the built-in 13-model catalog.
# BRIDGE_MODELS=opencode/big-pickle,opencode/deepseek-v4.1-flash-free
# BRIDGE_MODEL_CATALOG_JSON=/path/to/catalog-override.json
